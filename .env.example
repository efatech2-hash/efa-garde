# EFA GARDE - Template des Variables d'Environnement (.env.example)
# IMPORTANT : Ne JAMAIS committer de clés secrètes ou mots de passe réels dans ce fichier.
# Dupliquez ce fichier en .env.local pour le développement local.

# Supabase Configuration (Clés publiques / Anon)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Super Admin Gate (Identifiants d'accès sécurisé)
VITE_SUPER_ADMIN_EMAIL=admin@example.com
VITE_SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# Contact WhatsApp Officiel EFA TECH (Format international sans espace, ex: 22896100972)
VITE_WHATSAPP_NUMBER=22896100972
